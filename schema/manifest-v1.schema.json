{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadStack content restriction manifest v1",
  "description": "Structural aid only. The ReadStack Dart validator also enforces UTF-8 byte limits, unique rule IDs, disjoint active/revoked IDs, cumulative state and version monotonicity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "rules", "revokedRuleIds"],
  "properties": {
    "schemaVersion": {"const": 1},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "rules": {
      "type": "array",
      "maxItems": 2000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/rule"}
    },
    "revokedRuleIds": {
      "type": "array",
      "maxItems": 2000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ruleId"}
    }
  },
  "$defs": {
    "ruleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "repository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 201,
      "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$",
      "not": {"pattern": "^(\\.{1,2}/|[^/]+/\\.{1,2}$)"}
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\\\]+$",
      "not": {"pattern": "(^/|/$|//|(^|/)\\.{1,2}(/|$))"}
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "scope", "action", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/ruleId"},
        "repository": {"$ref": "#/$defs/repository"},
        "scope": {"enum": ["repository", "directory", "file"]},
        "action": {"enum": ["disableNative", "disableInApp", "removeEntry"]},
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        },
        "path": {"$ref": "#/$defs/path"},
        "revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "repository"}}, "required": ["scope"]},
          "then": {"not": {"required": ["path"]}},
          "else": {"required": ["path"]}
        }
      ]
    }
  }
}
